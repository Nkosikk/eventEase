@page
@model EventEase.Pages.Bookings.IndexModel

<div class="page-container">
    <div class="page-header">
        <h1>Bookings</h1>
        <a class="btn-create" asp-page="Create">+ Create New Booking</a>
    </div>

    <div class="search-section">
        <form method="get" class="search-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="search-controls">
                <select asp-for="SearchType" class="search-select">
                    <option value="all">All Fields</option>
                    <option value="bookingid">Booking ID</option>
                    <option value="eventname">Event Name</option>
                </select>
                <input asp-for="SearchTerm" type="text" placeholder="Enter search term..." class="search-input" />
            </div>
            <div class="filter-controls">
                <div class="filter-field">
                    <label asp-for="EventTypeId">Event Type</label>
                    <select asp-for="EventTypeId" class="search-select">
                        <option value="">All Event Types</option>
                        @foreach (var eventType in Model.EventTypes)
                        {
                            <option value="@eventType.EventTypeId">@eventType.EventTypeName</option>
                        }
                    </select>
                </div>
                <div class="filter-field">
                    <label asp-for="StartDate">From</label>
                    <input asp-for="StartDate" type="date" class="search-input" />
                </div>
                <div class="filter-field">
                    <label asp-for="EndDate">To</label>
                    <input asp-for="EndDate" type="date" class="search-input" />
                </div>
                <div class="filter-field">
                    <label asp-for="IsAvailable">Venue Availability</label>
                    <select asp-for="IsAvailable" class="search-select">
                        <option value="">All Venues</option>
                        <option value="true">Available</option>
                        <option value="false">Unavailable</option>
                    </select>
                </div>
            </div>
            <div class="search-actions">
                <button type="submit" class="search-button">Search</button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.EventTypeId.HasValue ||
                    Model.StartDate.HasValue || Model.EndDate.HasValue || Model.IsAvailable.HasValue)
                {
                    <a asp-page="Index" class="search-clear">Clear</a>
                }
            </div>
        </form>
    </div>

    @if (Model.Bookings.Any())
    {
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th>Booking ID</th>
                        <th>Customer</th>
                        <th>Email</th>
                        <th>Event</th>
                        <th>Event Type</th>
                        <th>Venue</th>
                        <th>Availability</th>
                        <th>Seats</th>
                        <th>Event Date</th>
                        <th>Booking Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Bookings)
                {
                    <tr>
                        <td><strong>@item.BookingId</strong></td>
                        <td>@item.CustomerName</td>
                        <td>@item.CustomerEmail</td>
                        <td>@item.EventName</td>
                        <td>@item.EventTypeName</td>
                        <td>@item.VenueName</td>
                        <td>@(item.IsAvailable ? "Available" : "Unavailable")</td>
                        <td>@item.NumberOfTickets tickets</td>
                        <td>@item.EventDate.ToString("MMM dd, yyyy")</td>
                        <td>@item.BookingDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            <div class="action-links">
                                <a asp-page="Edit" asp-route-id="@item.BookingId">Edit</a>
                                <a asp-page="Details" asp-route-id="@item.BookingId">View</a>
                                <a asp-page="Delete" asp-route-id="@item.BookingId">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.EventTypeId.HasValue ||
                Model.StartDate.HasValue || Model.EndDate.HasValue || Model.IsAvailable.HasValue)
            {
                <p>No bookings found matching your search criteria.</p>
                <a asp-page="Index">View all bookings</a>
            }
            else
            {
                <p>No bookings found. Create your first booking to get started!</p>
                <a class="btn-create" asp-page="Create">+ Create New Booking</a>
            }
        </div>
    }
</div>

<style>
    .search-section {
        margin: 20px 0;
        padding: 15px;
        background-color: #f8f9fa;
        border-radius: 4px;
    }

    .search-form {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .search-controls,
    .filter-controls,
    .search-actions {
        display: flex;
        gap: 10px;
        width: 100%;
        flex-wrap: wrap;
    }

    .filter-field {
        display: flex;
        flex: 1 1 180px;
        flex-direction: column;
        gap: 4px;
    }

    .search-select,
    .search-input {
        padding: 8px 12px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 14px;
    }

    .search-input {
        flex: 1;
        min-width: 200px;
    }

    .search-button {
        padding: 8px 16px;
        background-color: #007bff;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
    }

    .search-button:hover {
        background-color: #0056b3;
    }

    .search-clear {
        padding: 8px 16px;
        background-color: #6c757d;
        color: white;
        border-radius: 4px;
        text-decoration: none;
        font-size: 14px;
        display: flex;
        align-items: center;
    }

    .search-clear:hover {
        background-color: #545b62;
        text-decoration: none;
    }
</style>
