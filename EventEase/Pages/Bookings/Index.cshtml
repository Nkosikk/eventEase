@page
@model EventEase.Pages.Bookings.IndexModel

<div class="page-container">
    <div class="page-header">
        <h1>Bookings</h1>
        <a class="btn-create" asp-page="Create">+ Create New Booking</a>
    </div>

    <!-- Search Form -->
    <div class="search-section">
        <form method="get" class="search-form">
            <div class="search-controls">
                <select name="searchType" class="search-select">
                    <option value="all" selected="@(Model.SearchType == "all")">All Fields</option>
                    <option value="bookingid" selected="@(Model.SearchType == "bookingid")">Booking ID</option>
                    <option value="eventname" selected="@(Model.SearchType == "eventname")">Event Name</option>
                </select>
                <input type="text" name="searchTerm" placeholder="Enter search term..." value="@Model.SearchTerm" class="search-input" />
                <button type="submit" class="search-button">Search</button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a asp-page="Index" class="search-clear">Clear</a>
                }
            </div>
        </form>
    </div>

    @if (Model.Bookings.Any())
    {
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th>Booking ID</th>
                        <th>Customer</th>
                        <th>Email</th>
                        <th>Event</th>
                        <th>Venue</th>
                        <th>Seats</th>
                        <th>Event Date</th>
                        <th>Booking Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Bookings)
                {
                    <tr>
                        <td><strong>@item.BookingId</strong></td>
                        <td>@item.CustomerName</td>
                        <td>@item.CustomerEmail</td>
                        <td>@item.EventName</td>
                        <td>@item.VenueName</td>
                        <td>@item.NumberOfTickets tickets</td>
                        <td>@item.EventDate.ToString("MMM dd, yyyy")</td>
                        <td>@item.BookingDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            <div class="action-links">
                                <a asp-page="Edit" asp-route-id="@item.BookingId">Edit</a>
                                <a asp-page="Details" asp-route-id="@item.BookingId">View</a>
                                <a asp-page="Delete" asp-route-id="@item.BookingId">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <p>No bookings found matching your search criteria.</p>
                <a asp-page="Index">View all bookings</a>
            }
            else
            {
                <p>No bookings found. Create your first booking to get started!</p>
                <a class="btn-create" asp-page="Create">+ Create New Booking</a>
            }
        </div>
    }
</div>

<style>
    .search-section {
        margin: 20px 0;
        padding: 15px;
        background-color: #f8f9fa;
        border-radius: 4px;
    }

    .search-form {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .search-controls {
        display: flex;
        gap: 10px;
        width: 100%;
    }

    .search-select,
    .search-input {
        padding: 8px 12px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 14px;
    }

    .search-input {
        flex: 1;
        min-width: 200px;
    }

    .search-button {
        padding: 8px 16px;
        background-color: #007bff;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
    }

    .search-button:hover {
        background-color: #0056b3;
    }

    .search-clear {
        padding: 8px 16px;
        background-color: #6c757d;
        color: white;
        border-radius: 4px;
        text-decoration: none;
        font-size: 14px;
        display: flex;
        align-items: center;
    }

    .search-clear:hover {
        background-color: #545b62;
        text-decoration: none;
    }
</style>
</div>