@page "{id:int}"
@model EventEase.Pages.Bookings.EditModel

<h1>Edit Booking</h1>

<form method="post">
    <input type="hidden" asp-for="Booking.BookingId" />
    <div class="form-group">
        <label asp-for="Booking.CustomerName"></label>
        <input asp-for="Booking.CustomerName" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Booking.CustomerEmail"></label>
        <input asp-for="Booking.CustomerEmail" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Booking.EventId">Event</label>
        <select asp-for="Booking.EventId" asp-items="Model.EventList" class="form-control"></select>
    </div>
    <div class="form-group">
        <label asp-for="Booking.NumberOfTickets"></label>
        <input asp-for="Booking.NumberOfTickets" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>

<a asp-page="Index">Back to list</a>