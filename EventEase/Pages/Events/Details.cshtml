@page "{id:int}"
@model EventEase.Pages.Events.DetailsModel

<style>
    .event-details-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 20px;
    }

    .event-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .event-header h1 {
        color: #333;
        font-size: 2.5em;
        margin: 0;
    }

    .btn-back {
        display: inline-block;
        padding: 10px 20px;
        background-color: #f0f0f0;
        color: #667eea;
        text-decoration: none;
        border-radius: 6px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .btn-back:hover {
        background-color: #667eea;
        color: white;
    }

    .event-details-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        padding: 30px;
        margin-bottom: 40px;
    }

    .event-image {
        width: 100%;
        max-width: 600px;
        height: auto;
        border-radius: 8px;
        margin-bottom: 30px;
        display: block;
    }

    .event-info {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-top: 20px;
    }

    .info-item {
        padding: 15px;
        background-color: #f8f9ff;
        border-left: 4px solid #667eea;
        border-radius: 4px;
    }

    .info-item label {
        display: block;
        color: #667eea;
        font-weight: 600;
        font-size: 0.9em;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .info-item p {
        margin: 0;
        color: #333;
        font-size: 1.1em;
    }

    .event-description {
        background-color: #f8f9ff;
        padding: 20px;
        border-radius: 8px;
        line-height: 1.6;
        color: #555;
    }

    .section-title {
        font-size: 1.8em;
        color: #333;
        margin-top: 40px;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 3px solid #667eea;
    }

    .bookings-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

    .bookings-table thead {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .bookings-table th {
        padding: 18px 20px;
        text-align: left;
        font-weight: 600;
        font-size: 0.95em;
    }

    .bookings-table td {
        padding: 16px 20px;
        border-bottom: 1px solid #e0e0e0;
        color: #555;
    }

    .bookings-table tbody tr:hover {
        background-color: #f8f9ff;
    }

    .bookings-table tbody tr:last-child td {
        border-bottom: none;
    }

    .table-wrapper {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

    .empty-state {
        text-align: center;
        padding: 40px;
        color: #999;
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }
</style>

<style>
    @@media (max-width: 768px) {
        .event-info {
            grid-template-columns: 1fr;
        }

        .event-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .event-header h1 {
            font-size: 1.8em;
            margin-bottom: 15px;
        }
    }
</style>

<div class="event-details-container">
    <div class="event-header">
        <h1>@Model.Event.EventName</h1>
        <a class="btn-back" asp-page="Index">← Back to Events</a>
    </div>

    <div class="event-details-card">
        @if (!string.IsNullOrEmpty(Model.Event.ImageUrl))
        {
            <img src="@Model.Event.ImageUrl" alt="@Model.Event.EventName" class="event-image" />
        }

        @if (!string.IsNullOrEmpty(Model.Event.Description))
        {
            <div class="event-description">
                @Model.Event.Description
            </div>
        }

        <div class="event-info">
            <div class="info-item">
                <label>Event Date</label>
                <p>@Model.Event.EventDate.ToString("MMMM dd, yyyy")</p>
            </div>
            <div class="info-item">
                <label>Venue</label>
                <p>@Model.Event.Venue?.VenueName ?? "Not specified"</p>
            </div>
        </div>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2 class="section-title" style="margin-bottom: 0;">Bookings for this Event</h2>
        <a href="/Bookings/Create?eventId=@Model.Event.EventId" style="display: inline-block; padding: 10px 20px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; text-decoration: none; border-radius: 6px; font-weight: 500;">+ Create Booking</a>
    </div>

    @if (Model.Event.Bookings != null && Model.Event.Bookings.Any())
    {
        <div class="table-wrapper">
            <table class="bookings-table">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Email</th>
                        <th>Number of Tickets</th>
                        <th>Booking Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model.Event.Bookings)
                    {
                        <tr>
                            <td><strong>@booking.CustomerName</strong></td>
                            <td>@booking.CustomerEmail</td>
                            <td>@booking.NumberOfTickets @(booking.NumberOfTickets == 1 ? "ticket" : "tickets")</td>
                            <td>@booking.BookingDate.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div style="margin-top: 20px; padding: 15px; background: #e8f5e9; border-radius: 8px; color: #2e7d32;">
            <strong>Total Bookings:</strong> @Model.Event.Bookings.Count | <strong>Total Tickets:</strong> @Model.Event.Bookings.Sum(b => b.NumberOfTickets)
        </div>
    }
    else
    {
        <div class="empty-state">
            <p>No bookings yet for this event. Be the first to book!</p>
            <a href="/Bookings/Create?eventId=@Model.Event.EventId" style="display: inline-block; padding: 12px 25px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; text-decoration: none; border-radius: 6px; font-weight: 500; margin-top: 15px;">+ Create Booking</a>
        </div>
    }
</div>